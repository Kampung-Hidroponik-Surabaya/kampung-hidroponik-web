# Normalize all line endings to LF on commit
# Prevents CRLF commits from Windows PowerShell
* text=auto eol=lf

# Force LF on these file types explicitly
*.ts    text eol=lf
*.tsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.svg   binary